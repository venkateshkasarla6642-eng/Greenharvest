{
  "name": "GreenHarvest Fresh Vegetables",
  "short_name": "GreenHarvest",
  "description": "Order 100% farm-fresh vegetables online. Tomatoes, Potatoes, Onions, Carrots, Spinach and more — delivered to your doorstep. Handpicked daily from local organic farms.",
