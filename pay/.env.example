# ============================================================
# GreenHarvest Pay — Environment Variables Template
# Copy this template and fill in your actual values.
# NEVER commit real secrets to git history.
# Set all variables in Render Dashboard → Environment.
# ============================================================

# ── Existing app variables (already set) ────────────────────
DATABASE_URL=postgresql://greenharvest:PASSWORD@HOST:5432/greenharvest
# OR individual variables:
# DB_HOST=localhost
# DB_USER=postgres
# DB_PASS=
# DB_NAME=greenharvest
# DB_PORT=5432

# ── GreenHarvest Pay Mode ────────────────────────────────────
# 'sandbox' = test mode, no real money
# 'live'    = real payments (requires merchant credentials below)
GH_PAY_MODE=sandbox

# ── Live Provider (set only when enabling live payments) ─────
# Options: none | razorpay | cashfree
GH_LIVE_PROVIDER=none

# ── Razorpay Credentials (LIVE only) ────────────────────────
# Get from: https://dashboard.razorpay.com/app/keys
# Requires: approved Razorpay merchant account
GH_LIVE_KEY_ID=rzp_live_XXXXXXXXXXXXXXXX
GH_LIVE_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Webhook Secret (LIVE only) ────────────────────────────────
# Get from: Razorpay Dashboard → Webhooks → Secret
# Webhook URL to configure: https://YOUR-APP.onrender.com/pay/webhook.php
GH_WEBHOOK_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Application URL (used in setup_owner.php output) ─────────
APP_URL=https://YOUR-APP.onrender.com
